    {"type":"arrow","id":"arrow_cg_dispatch","x":1400,"y":2535,"width":0,"height":455,"strokeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40409,"version":1,"versionNonce":40410,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"points":[[0,0],[0,455]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow"},

    {"type":"rectangle","id":"event_dispatcher","x":1160,"y":2995,"width":480,"height":120,"strokeColor":"#1e3a5f","backgroundColor":"#60a5fa","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40501,"version":1,"versionNonce":40502,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"event_dispatcher_text","x":1190,"y":3020,"width":420,"height":70,"text":"统一生命周期协调器\n串行化事件 + generation 过滤旧回调\n把事件归一化为下面 7 种动作","originalText":"统一生命周期协调器\n串行化事件 + generation 过滤旧回调\n把事件归一化为下面 7 种动作","fontSize":18,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40503,"version":2,"versionNonce":40504,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"arrow","id":"arrow_dispatch_actions","x":1400,"y":3120,"width":0,"height":85,"strokeColor":"#1e3a5f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40505,"version":1,"versionNonce":40506,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"points":[[0,0],[0,85]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow"},
    {"type":"rectangle","id":"normalized_actions","x":100,"y":3210,"width":1600,"height":230,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40507,"version":1,"versionNonce":40508,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"normalized_actions_text","x":130,"y":3235,"width":1540,"height":180,"text":"归一化动作（所有恢复路径只能从这里进入）\n\nSTART          创建 DeviceConnectionMonitor + HIDMonitor + CGEventMonitor\nSUSPEND        清 verified axes / pending / route，释放 HID；保留 takeoverRequested\nFULL_REBUILD   重建三个监听器并重新枚举；takeoverRequested=true 时继续 REACQUIRE\nINVALIDATE     设备/链路断开：清 route、feature、battery、verified axes，输出 fail-open\nVERIFY         对现有 route 做 GetMode；漂移则 SetMode + GetMode，失败转 INVALIDATE\nREACQUIRE      新 route 上重新发现 0x2121/0x2150、写模式并回读；有限重试后等待事件\nRESTORE_STOP   用户关闭或退出：写回原模式、回读、注销全部 callback 和 run-loop source","originalText":"归一化动作（所有恢复路径只能从这里进入）\n\nSTART          创建 DeviceConnectionMonitor + HIDMonitor + CGEventMonitor\nSUSPEND        清 verified axes / pending / route，释放 HID；保留 takeoverRequested\nFULL_REBUILD   重建三个监听器并重新枚举；takeoverRequested=true 时继续 REACQUIRE\nINVALIDATE     设备/链路断开：清 route、feature、battery、verified axes，输出 fail-open\nVERIFY         对现有 route 做 GetMode；漂移则 SetMode + GetMode，失败转 INVALIDATE\nREACQUIRE      新 route 上重新发现 0x2121/0x2150、写模式并回读；有限重试后等待事件\nRESTORE_STOP   用户关闭或退出：写回原模式、回读、注销全部 callback 和 run-loop source","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40509,"version":1,"versionNonce":40510,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
  ],
  "appState": {"viewBackgroundColor":"#ffffff","gridSize":20},
  "files": {}
}
