    {"type":"text","id":"intent_on_text","x":545,"y":1348,"width":200,"height":55,"text":"INTENT ON\ntakeoverRequested=true","originalText":"INTENT ON\ntakeoverRequested=true","fontSize":17,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":30111,"version":1,"versionNonce":30112,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
