    {"type":"text","id":"intent_on_label","x":350,"y":1310,"width":150,"height":36,"text":"用户 ON\n保存意图，不要求设备当前在线","originalText":"用户 ON\n保存意图，不要求设备当前在线","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":30107,"version":1,"versionNonce":30108,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
